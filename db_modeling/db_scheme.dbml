// Personal Workout App — database schema model (DBML)
//
// Mirrors the app's JSON model but normalized for a future backend/sync.
// Conventions:
//  - text IDs are UUIDs generated by the app (crypto.randomUUID), safe to merge
//    across devices (auto-increment ints would collide).
//  - every row carries created_at/updated_at; deletable entities use deleted_at
//    (soft delete) so deletions can propagate during sync.
//  - weights are decimals: the app supports 1.25 kg / 2.5 kg increments.
//  - history is immutable: session rows snapshot the scheme/weights actually used.
//
// SQL CHECK constraints to add in the migrations (not expressible in DBML):
//  - exercise / exercise_in_workout_plan: num_working_sets required iff
//    set_scheme = 'fixed_sets'; num_total_reps required iff 'fixed_reps'.
//  - workout_plate.count >= 0.
//  - workout_set.reps IS NULL OR reps > 0.

Project workout_tracker {
  database_type: 'SQLite'
  Note: 'Offline-first workout tracker; UUID PKs + timestamps + soft deletes for multi-device sync.'
}

Enum exercise_category {
  barbell
  dumbbell
  bodyweight
  machine
  other
}

Enum exercise_set_scheme {
  fixed_sets
  fixed_reps
}

Enum set_type {
  warmup
  working
  extra
}

// Provenance: manual entries vs. data installed from a cookie-cutter template.
Enum entity_source {
  user
  template
}

// ---------------------------------------------------------------------------
// Catalog: movements. The scheme fields here are DEFAULTS only; they are
// copied into a plan slot (and later snapshotted into a session) when used.
// ---------------------------------------------------------------------------
Table exercise {
  id text [pk, note: 'UUID generated by the app']
  name varchar(255) [not null]
  category exercise_category [not null, default: 'barbell']
  set_scheme exercise_set_scheme [not null, default: 'fixed_sets']
  num_warmup_sets int [not null, default: 3]
  num_working_sets int [note: 'required when set_scheme = fixed_sets']
  num_total_reps int [note: 'required when set_scheme = fixed_reps']
  source entity_source [not null, default: 'user', note: 'template = created by installing a cookie-cutter template']
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]
  deleted_at datetime [note: 'soft delete: hide from pickers, keep history reachable']

  indexes {
    name [unique, name: 'uq_exercise_name']
    category
  }
}

// ---------------------------------------------------------------------------
// Programs and their exercise slots. The effective scheme for a program lives
// here, so the same exercise can be 5x5 in one plan and 3x5 in another without
// duplicating the exercise (weights stay comparable across plans).
// ---------------------------------------------------------------------------
Table workout_plan {
  id text [pk]
  name varchar(255) [not null]
  description text [note: 'further details describing the workout, with possibly a url if required']
  source entity_source [not null, default: 'user']
  template_key varchar(100) [note: 'catalog id when installed from a template, e.g. stronglifts-a']
  template_version int [note: 'template catalog version this copy was installed from']
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]
  deleted_at datetime

  indexes {
    name [unique, name: 'uq_workout_plan_name']
    template_key [unique, name: 'uq_plan_template_key']
  }
}

Table exercise_in_workout_plan {
  id text [pk]
  workout_plan_id text [not null]
  exercise_id text [not null]
  position int [not null, note: 'order of the exercise inside the plan']
  set_scheme exercise_set_scheme [not null]
  num_warmup_sets int [not null, default: 3]
  num_working_sets int [note: 'required when set_scheme = fixed_sets']
  num_total_reps int [note: 'required when set_scheme = fixed_reps']

  indexes {
    (workout_plan_id, exercise_id) [unique, name: 'uq_plan_exercise']
    (workout_plan_id, position)
  }
}

// ---------------------------------------------------------------------------
// Execution. A session can cover several exercises (the "Conclude workout"
// flow) and survives plan edits/deletions thanks to snapshots.
// ---------------------------------------------------------------------------
Table workout_session {
  id text [pk]
  performed_on date [not null]
  workout_plan_id text [note: 'nullable: deleting a plan must not erase history']
  plan_name varchar(255) [note: 'snapshot of the plan name at session start']
  note text
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]
  deleted_at datetime

  indexes {
    performed_on
  }
}

Table workout_session_exercise {
  id text [pk]
  workout_session_id text [not null]
  exercise_id text [not null]
  plan_entry_id text [note: 'plan slot this exercise was started from, if any']
  position int [not null]
  // Snapshot of what was actually performed, including per-workout overrides.
  set_scheme exercise_set_scheme [not null]
  num_warmup_sets int [not null]
  num_working_sets int [note: 'snapshot; set when set_scheme = fixed_sets']
  num_total_reps int [note: 'snapshot; set when set_scheme = fixed_reps']
  training_weight_kg decimal(6,2) [note: 'total external load; for bodyweight exercises, the added weight']
  note text
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]

  indexes {
    (workout_session_id, exercise_id) [unique, name: 'uq_session_exercise']
  }
}

// One row per set (warm-up, working or extra), in display order.
Table workout_set {
  id text [pk]
  workout_session_exercise_id text [not null]
  set_index int [not null]
  set_type set_type [not null]
  weight_kg decimal(6,2) [not null, note: 'bodyweight exercises: added weight (0 when pure bodyweight)']
  reps int [note: 'NULL while planned but reps not logged yet']
  rpe decimal(3,1) [note: 'optional; reserved for future use']
  note text
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]

  indexes {
    (workout_session_exercise_id, set_index) [unique, name: 'uq_set_index']
  }
}

// ---------------------------------------------------------------------------
// Weight profiles (bar + available plates) for the plate calculator.
// count is the TOTAL number of that plate across BOTH sides; NULL = unlimited
// (the app's JSON stores Infinity as null, so this maps directly).
// ---------------------------------------------------------------------------
Table weight_profile {
  id text [pk]
  name varchar(255) [not null]
  barbell_kg decimal(5,2) [not null]
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]
  deleted_at datetime

  indexes {
    name [unique, name: 'uq_weight_profile_name']
  }
}

Table weight_plate {
  id text [pk]
  weight_profile_id text [not null]
  weight_kg decimal(5,2) [not null]
  count int [note: 'total plates across both sides; NULL = unlimited']

  indexes {
    (weight_profile_id, weight_kg) [unique, name: 'uq_profile_plate']
  }
}

Ref: exercise_in_workout_plan.workout_plan_id > workout_plan.id [delete: cascade]
Ref: exercise_in_workout_plan.exercise_id > exercise.id [delete: restrict]
Ref: workout_session.workout_plan_id > workout_plan.id [delete: set null]
Ref: workout_session_exercise.workout_session_id > workout_session.id [delete: cascade]
Ref: workout_session_exercise.exercise_id > exercise.id [delete: restrict]
Ref: workout_session_exercise.plan_entry_id > exercise_in_workout_plan.id [delete: set null]
Ref: workout_set.workout_session_exercise_id > workout_session_exercise.id [delete: cascade]
Ref: weight_plate.weight_profile_id > weight_profile.id [delete: cascade]
